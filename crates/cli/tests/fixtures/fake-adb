#!/bin/sh
# Stand-in for adb used by the integration tests. It answers the commands mobile-bridge sends with
# captured-style output for one Android 14 device ("FAKE123") running com.example.
set -u

if [ "$1" = "version" ]; then
    echo "Android Debug Bridge version 1.0.41"
    exit 0
fi
if [ "$1" = "devices" ]; then
    echo "List of devices attached"
    echo "FAKE123                device usb:1-1 product:panther model:Pixel_7 device:panther transport_id:1"
    exit 0
fi
if [ "$1" != "-s" ] || [ "$2" != "FAKE123" ]; then
    echo "adb: device '$2' not found" >&2
    exit 1
fi
if [ "$3" = "pull" ]; then
    echo "trace" > "$5"
    exit 0
fi
command="$4"
now=$(date +%s)

dumpsys() {
    case "$1" in
        -l) printf '%s\n' "Currently running services:" "  battery" "  package" ;;
        package)
            printf '%s\n' "    install permissions:" "      android.permission.INTERNET: granted=true" \
                "      runtime permissions:" "        android.permission.CAMERA: granted=false, flags=[ USER_SET ]" ;;
        *) echo "$1 service state" ;;
    esac
}

case "$command" in
    getprop)
        printf '%s\n' "[ro.build.version.sdk]: [34]" "[ro.build.version.release]: [14]" \
            "[ro.product.manufacturer]: [Google]" "[ro.product.model]: [Pixel 7]" "[ro.build.type]: [user]" \
            "[ro.product.cpu.abi]: [arm64-v8a]" "[ro.hardware]: [panther]" ;;
    "pm path com.example") echo "package:/data/app/com.example/base.apk" ;;
    "pm path "*) exit 1 ;;
    "pm list packages"*) printf '%s\n' "package:com.example versionCode:7 uid:10123" "package:com.android.settings uid:1000" ;;
    "ps -A -o PID,PPID,USER,NAME")
        printf '%s\n' "  PID  PPID USER           NAME" "    1     0 root           init" \
            " 1000     1 system         system_server" " 4000   600 u0_a123        com.example" ;;
    "cat /proc/uptime") echo "$now.00 1.00" ;;
    "cat /proc/uptime; for p in"*)
        echo "$now.00 1.00"
        echo "@pid 4000"
        echo "4000 (com.example) S 600 600 0 0 -1 0 0 0 0 0 $now 0 0 0 20 0 30 0 1 1 1"
        printf 'VmRSS:\t  81234 kB\n' ;;
    "date +%s") echo "$now" ;;
    "logcat -d -t 1"*) echo "$now.000  1000  1000 I ActivityManager: ready" ;;
    "for b in main system crash events;"*) printf '%s\n' "buffer:main" "buffer:system" "buffer:crash" "buffer:events" "$now" ;;
    "echo @@mobile-bridge-snapshot@@;"*) eval "$command" ;;
    "logcat -v threadtime -v epoch"*)
        echo "--------- beginning of main"
        echo "$now.100  4000  4000 I Example: login with token=abc123secret"
        echo "$now.200  4000  4001 W Example: slow network"
        echo "$now.300  9999  9999 I OtherApp: unrelated line"
        echo "--------- beginning of crash"
        echo "$now.400  4000  4000 E AndroidRuntime: FATAL EXCEPTION: main"
        echo "--------- beginning of events"
        echo "$now.500  1000  1100 I am_crash: [0,4000,com.example,948459078,java.lang.IllegalStateException,boom,Main.kt,12]"
        exec sleep 60 ;;
    dumpsys*) eval "$command" ;;
    "command -v perfetto" | "command -v su") exit 1 ;;
    *) echo "/system/bin/sh: unsupported fake command: $command" >&2; exit 127 ;;
esac
